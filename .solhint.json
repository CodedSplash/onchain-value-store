{
  "extends": "solhint:recommended",
  "rules": {
    "compiler-version": ["error", "0.8.37"],
    "func-visibility": ["warn", { "ignoreConstructors": true }],
    "no-unused-vars": "error",
    "use-natspec": "off",
    "gas-custom-errors": "error",
    "custom-errors": "error",
    "reason-string": "off"
  }
}
