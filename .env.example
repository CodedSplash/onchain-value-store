# ValueStore configuration. Copy to `.env` and fill in:  cp .env.example .env
# `.env` is git-ignored. NEVER commit it and NEVER put a wallet with real funds here.

# --- Wallet --------------------------------------------------------------
# Private key (0x-prefixed hex) of a SEPARATE TEST wallet used to deploy and
# to send write transactions (set-*, clear-*, add-editor, remove-editor).
# Fund it from a Sepolia faucet; it must never hold real ETH.
PRIVATE_KEY=

# --- RPC endpoints -------------------------------------------------------
# Sepolia JSON-RPC URL (Alchemy, Infura, or any public endpoint).
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Optional: Hoodi testnet JSON-RPC URL (only needed for --network hoodi).
HOODI_RPC_URL=

# --- Verification --------------------------------------------------------
# Optional. If set, deploy.ts verifies the contract on Etherscan after deploy.
# Get a free key at https://etherscan.io/myapikey (Etherscan API v2, one key for all chains).
ETHERSCAN_API_KEY=

# --- Deployment parameters -----------------------------------------------
# Contract mode, fixed forever at deploy time: public | private
MODE=public
# Optional owner address. Empty means: the deployer address becomes owner.
INITIAL_OWNER=
# Optional: confirmations deploy.ts waits for on public testnets (default 2).
CONFIRMATIONS=2

# --- Encryption (private mode only) --------------------------------------
# 32-byte AES-256-GCM key as 64 hex chars. Generate with:  npm run keygen
# Everyone who writes or reads a private-mode contract needs this key.
# It never goes on-chain. If you lose it, the stored data is unrecoverable.
VALUESTORE_KEY=

# --- Tooling -------------------------------------------------------------
# Optional: path to a local native solc 0.8.37 binary, for environments that
# cannot reach binaries.soliditylang.org. Leave empty normally.
SOLC_PATH=
